{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/jobber-auth/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/jobber-auth/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/jobber-auth",
  "projects": {
    "jobber-auth": {
      "type": "application",
      "root": "apps/jobber-auth",
      "entryFile": "main",
      "sourceRoot": "apps/jobber-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/jobber-auth/tsconfig.app.json"
      }
    },
    "jobber-jobs": {
      "type": "application",
      "root": "apps/jobber-jobs",
      "entryFile": "main",
      "sourceRoot": "apps/jobber-jobs/src",
      "compilerOptions": {
        "tsConfigPath": "apps/jobber-jobs/tsconfig.app.json"
      }
    },
    "libs/nestjs": {
      "type": "library",
      "root": "libs/libs/nestjs",
      "entryFile": "index",
      "sourceRoot": "libs/libs/nestjs/src",
      "compilerOptions": {
        "tsConfigPath": "libs/libs/nestjs/tsconfig.lib.json"
      }
    },
    "nestjs": {
      "type": "library",
      "root": "libs/nestjs",
      "entryFile": "index",
      "sourceRoot": "libs/nestjs/src",
      "compilerOptions": {
        "tsConfigPath": "libs/nestjs/tsconfig.lib.json"
      }
    },
    "pulsar": {
      "type": "library",
      "root": "libs/pulsar",
      "entryFile": "index",
      "sourceRoot": "libs/pulsar/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pulsar/tsconfig.lib.json"
      }
    }
  }
}
